# Canonical origin is verified www.aslagency.dev by default.
# Change only after verifying a new production domain, then rebuild.
ASL_SITE_URL=https://www.aslagency.dev

# Vercel preview/development deployments automatically get noindex.
# Set true for any independently hosted staging environment; rebuild afterwards.
SEO_NOINDEX=false

# No analytics ID or tracker is installed. See docs/seo/OWNER_SETUP_CHECKLIST.md.
